# St. Philomena's College (Autonomous) - Frontend Environment Template
# Duplicate this file to .env or .env.production and populate appropriate values.

# Backend API Base URL
# For local development: http://localhost:8000/api/v1
# For production: https://your-domain.com/api/v1 (or relative /api/v1 if reverse-proxied)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# College Portal Name
VITE_COLLEGE_NAME="St. Philomena's College (Autonomous)"

# Environment Mode: 'development' | 'production' | 'staging'
VITE_APP_ENV=development
